{
  "name": "saeshify",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:worker": "tsx local-worker/server.ts",
    "local:demo": "concurrently -n app,worker -c cyan,magenta \"npm run dev\" \"npm run local:worker\"",
    "cf:build": "next build --webpack && opennextjs-cloudflare build && node scripts/strip-local-media.mjs",
    "cf:preview": "wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.19.11",
    "clsx": "2.1.1",
    "lucide-react": "0.561.0",
    "next": "16.2.9",
    "node-addon-api": "8.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.3",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.9",
    "node-gyp": "13.0.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.101.0"
  }
}
