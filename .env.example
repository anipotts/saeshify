# public app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# private spotify mode
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# private lyric and worker adapters
ALLOW_LRCLIB_PRIVATE_MODE=false
LOCAL_ANALYSIS_WORKER_URL=http://localhost:8788

# preferred private demo path:
# copy docs/mf-doom-local-bank.template.json to public/local-media/manifest.json
# and keep audio/lrc files under ignored public/local-media/.

# legacy fixture-only audio overrides. prefer the local-media manifest for Madvillainy.
NEXT_PUBLIC_SAESHIFY_DOOM_SLOT_A_AUDIO_URL=
NEXT_PUBLIC_SAESHIFY_DOOM_SLOT_B_AUDIO_URL=
